# Operator-owned shell configuration; no application secrets here.
# Copy to /etc/finix/deploy.env and run FINIX_DEPLOY_CONFIG=/etc/finix/deploy.env bash deploy.sh --dry-run
FINIX_API_ENV=/etc/finix/api.env
FINIX_WEB_ENV=/etc/finix/web.env
FINIX_ADMIN_ENV=/etc/finix/admin.env
FINIX_RELEASE_ROOT=/opt/finix/releases
FINIX_SHARED_ROOT=/opt/finix/shared
FINIX_API_CURRENT=/opt/finix/current
FINIX_WEB_CURRENT=/var/www/finix-web/current
FINIX_ADMIN_CURRENT=/var/www/finix-admin/current
FINIX_BACKUP_ROOT=/var/backups/finix
FINIX_DB_CONTAINER=finix-production-db-1
FINIX_SECRETS_DIR=/opt/finix/source/ops/database/.secrets
FINIX_DEPLOY_BRANCH=main
# Only for the first controlled move from a legacy PM2 cwd; remove afterwards.
FINIX_RECREATE_PM2_ONCE=false
FINIX_WEB_HEALTH_URL=https://finixarg.com/release.json
FINIX_ADMIN_HEALTH_URL=https://admin.finixarg.com/release.json
# Set only if Google is deliberately disabled until credentials are supplied.
FINIX_ALLOW_GOOGLE_DISABLED=false
# Optional external backup destination, SSH known_hosts already verified.
# FINIX_BACKUP_REMOTE=backup-user@backup-host:/srv/backups/finix/
