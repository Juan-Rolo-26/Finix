generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  pushSubscriptions PushSubscription[]
  id                String             @id @default(uuid())
  email             String             @unique
  username          String             @unique
  password          String? // Managed by Finix for email/password auth; Supabase remains for OAuth
  role              String             @default("USER") // USER, CREATOR, ADMIN
  status            String             @default("ACTIVE") // ACTIVE, BANNED
  shadowbanned      Boolean            @default(false)
  lastLogin         DateTime?
  flags             String? // JSON array of warnings

  // Auth additions
  emailVerified            Boolean   @default(false)
  emailVerificationCode    String?
  emailVerificationExpires DateTime?
  loginVerificationCode    String?
  loginVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  adminTwoFactorEnabled    Boolean   @default(false)
  adminTotpSecret          String?
  adminTotpTempSecret      String?
  adminTotpTempExpires     DateTime?
  adminLockedUntil         DateTime?
  adminFailedLoginAttempts Int       @default(0)

  // Perfil básico
  bio       String?
  bioLong   String? // Bio extendida para creadores de contenido
  avatarUrl String?
  bannerUrl String? // Banner/portada del perfil

  // Tipo de cuenta
  isInfluencer             Boolean @default(false)
  isVerified               Boolean @default(false)
  financialAdvisorVerified Boolean @default(false)
  accountType              String  @default("BASIC") // BASIC, PRO, CREATOR, ANALYST
  plan                     String  @default("FREE") // FREE | PRO
  // null = billing/role rules decide; true/false = explicit admin grant/revoke
  proAccessOverride        Boolean?
  stripeCustomerId         String? @unique
  subscriptionStatus       String  @default("INACTIVE") // INACTIVE | ACTIVE | CANCELED | PAST_DUE | EXPIRED

  // IA limits (for PRO controls)
  aiUsageThisMonth Int       @default(0)
  aiUsageLimit     Int       @default(0)
  lastAiUsageReset DateTime?

  // Información profesional
  title    String? // ej: "Trading Analyst", "Crypto Investor"
  company  String?
  location String?
  website  String?

  // Redes sociales
  linkedinUrl  String?
  twitterUrl   String?
  youtubeUrl   String?
  instagramUrl String?

  // Experiencia y credenciales
  yearsExperience Int?
  specializations String? // JSON array: ["Stocks", "Crypto", "Options"]
  certifications  String? // JSON array de certificaciones

  // Estadísticas públicas
  totalReturn Float? // Retorno total del portfolio (si es público)
  winRate     Float? // Tasa de éxito en trades
  riskScore   Float? // Score de riesgo (1-10)

  // Configuración de privacidad
  isProfilePublic       Boolean @default(true)
  showPortfolio         Boolean @default(false)
  showStats             Boolean @default(false)
  acceptingFollowers    Boolean @default(true)
  showActivity          Boolean @default(true)
  showExactReturns      Boolean @default(true)
  returnsVisibilityMode String  @default("exact") // "exact" | "range"

  // Preferencias de la app
  language                     String  @default("es-AR")
  currency                     String  @default("USD")
  autoRefreshMarket            Boolean @default(true)
  compactTables                Boolean @default(false)
  showAdvancedMetrics          Boolean @default(false)
  theme                        String  @default("dark") // "dark" | "light" | "system"
  chartDensity                 String  @default("normal") // "basic" | "normal" | "advanced"
  marketNotifications          Boolean @default(false)
  investmentEmailNotifications Boolean @default(false) // Opt-in exclusivo para alertas y campañas de inversión PRO
  timezone                     String  @default("America/Argentina/Cordoba")
  notificationPrefs            String? // JSON for notification preferences

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Relaciones
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  commentLikes CommentLike[]
  reposts      Repost[]
  saves        Save[]
  postReports  PostReport[]
  followedBy   Follow[]      @relation("following")
  following    Follow[]      @relation("follower")

  portfolios Portfolio[]
  watchlists Watchlist[]

  personalFinanceAccounts          PersonalFinanceAccount[]
  personalFinanceTransactions     PersonalFinanceTransaction[]
  personalFinanceBudgets          PersonalFinanceBudget[]
  personalFinanceGoals            PersonalFinanceGoal[]
  personalFinanceRecurringPayments PersonalFinanceRecurringPayment[]
  personalFinanceCards            PersonalFinanceCard[]

  // Relations: Communities
  createdCommunities       Community[]            @relation("CommunityCreator")
  communityMemberships     CommunityMember[]
  communityResources       CommunityResource[]
  communityPayments        CommunityPayment[]
  communityJoinRequests    CommunityJoinRequest[]
  createdInvites           CommunityInvite[]      @relation("CommunityInviteCreator")
  communityReportsSent     CommunityReport[]      @relation("CommunityReporter")
  communityReportsReviewed CommunityReport[]      @relation("CommunityReportReviewer")
  communityAuditLogs       CommunityAuditLog[]    @relation("CommunityAuditActor")
  subscriptions            Subscription[]
  creatorBalance           CreatorBalance?
  paymentLogs              PaymentLog[]
  creatorApplication       CreatorApplication?

  isCreator Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Messaging
  conversations1          Conversation[]            @relation("ConvParticipant1")
  conversations2          Conversation[]            @relation("ConvParticipant2")
  conversationMemberships ConversationParticipant[]
  createdConversations    Conversation[]            @relation("ConversationCreator")
  sentMessages            DirectMessage[]           @relation("SentMessages")
  stories                 Story[]
  storyViews              StoryView[]
  storyLikes              StoryLike[]

  // Admin relations
  adminLogs         AdminAuditLog[]          @relation("AdminActor")
  proEmailCampaigns ProEmailCampaign[]       @relation("ProEmailCampaignCreator")
  emailRecipients   EmailCampaignRecipient[]
  emailEvents       EmailEvent[]
  emailPreferences  EmailPreference?
  emailSegments     EmailSegment[]           @relation("EmailSegmentCreator")
  emailMedia        EmailMedia[]
  adminSessions     AdminSession[]
  userSessions      UserSession[]
  reportsCreated    Report[]                 @relation("Reporter")

  // Notifications
  notifications       Notification[] @relation("UserNotifications")
  notificationsCaused Notification[] @relation("NotificationActor")

  // Hub (Comunidad Finix)
  hubMessages  HubMessage[]  @relation("HubMessages")
  hubPosts     HubPost[]     @relation("HubPosts")
  hubComments  HubComment[]  @relation("HubComments")
  hubEvents    HubEvent[]    @relation("HubEvents")
  hubResources HubResource[] @relation("HubResources")

  // Financial Advisor Verifications
  financialVerifications         FinancialAdvisorVerification[]  @relation("UserFinancialVerifications")
  financialVerificationsReviewed FinancialAdvisorVerification[]  @relation("FinancialVerificationsReviewed")
  financialVerificationAuditLogs FinancialVerificationAuditLog[] @relation("FinancialVerificationAuditLogs")

  // Technical Chart Analyses
  chartAnalyses ChartAnalysis[] @relation("UserChartAnalyses")

  // Market Alerts
  alerts MarketAlert[]

  @@index([username])
  @@index([createdAt])
}

model CreatorApplication {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  bio          String
  experience   String
  education    String
  documentsUrl String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("follower", fields: [followerId], references: [id])
  following   User   @relation("following", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model Post {
  id       String @id @default(uuid())
  content  String
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Type: post | image | chart
  type String @default("post")

  visibility String    @default("VISIBLE") // VISIBLE, HIDDEN
  deletedAt  DateTime?

  // Chart-specific
  assetSymbol  String?
  analysisType String? // "technical" | "fundamental"
  riskLevel    String? // "low" | "medium" | "high"

  // Edit window (text only editable for 15 min after creation)
  contentEditedAt DateTime?

  tickers String @default("") // Comma separated

  // Threading / Conversations
  parentId String?
  parent   Post?   @relation("PostThread", fields: [parentId], references: [id])
  replies  Post[]  @relation("PostThread")

  // Quoting functionality
  quotedPostId String?
  quotedPost   Post?   @relation("QuotePost", fields: [quotedPostId], references: [id])
  quotes       Post[]  @relation("QuotePost")

  // Metrics
  viewCount Int @default(0)

  // Relations
  media            PostMedia[]
  likes            Like[]
  comments         Comment[] // Keep legacy comments for now if needed, but the new threading uses 'Post' referencing itself
  reposts          Repost[]
  saves            Save[]
  reports          PostReport[]
  sharedInMessages DirectMessage[] @relation("SharedPostMessages")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Community   Community? @relation(fields: [communityId], references: [id])
  communityId String?

  targetVisibility  String @default("PUBLIC") // PUBLIC, MEMBERS, PREMIUM_TIER
  requiredTierLevel Int    @default(0)

  // Community Section & Pinned
  sectionId          String?
  section            CommunitySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  isPinned           Boolean           @default(false)
  pinnedAt           DateTime?
  isCommentsDisabled Boolean           @default(false)

  // Chart Analysis Integration
  chartAnalysisVersionId String?
  chartAnalysisVersion   ChartAnalysisVersion? @relation(fields: [chartAnalysisVersionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([communityId])
  @@index([communityId, isPinned])
  @@index([sectionId])
  @@index([chartAnalysisVersionId])
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  mediaType String // "image"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Comment {
  // Legacy comment system, eventually you might migrate everything to Post-to-Post replies
  id       String @id @default(uuid())
  content  String
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  // Nested replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  likes CommentLike[]

  createdAt DateTime @default(now())

  @@index([postId])
}

model CommentLike {
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model Like {
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model Repost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // We remove 'comment' string. A "quote tweet" will now be a Post that has quotedPostId. 
  // A Repost is ONLY a direct share of the original post without modification.

  @@unique([userId, postId])
}

model Save {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model PostReport {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  reason    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Portfolio {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nombre             String
  descripcion        String?
  objetivo           String?
  monedaBase         String  @default("USD")
  nivelRiesgo        String  @default("medio")
  modoSocial         Boolean @default(false)
  esPrincipal        Boolean @default(false)
  admiteBienesRaices Boolean @default(false)

  // Relations
  holdings     Holding[]
  transactions Transaction[]
  cashAccounts CashAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Asset {
  id                String  @id @default(uuid())
  ticker            String  @unique
  name              String
  type              String // STOCK, CRYPTO, ETF, BOND, CEDEAR, INDEX
  currency          String  @default("USD")
  symbol            String? // e.g. "NASDAQ:AAPL", "BINANCE:BTCUSDT"
  exchange          String? // e.g. "NASDAQ", "NYSE", "BYMA", "BINANCE"
  country           String? // e.g. "US", "AR"
  logo              String?
  tradingViewSymbol String? // canonical TradingView chart symbol
  providerSymbol    String?
  active            Boolean @default(true)

  holdings     Holding[]
  transactions Transaction[]
  alerts       MarketAlert[]
}

model MarketAlert {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId             String?
  asset               Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  ticker              String
  name                String
  alertType           String    @default("PRICE_TARGET") // PRICE_TARGET, PERCENT_CHANGE, 52W_HIGH, 52W_LOW
  targetValue         Float
  condition           String // GREATER_THAN, LESS_THAN, CHANGE_PCT_UP, CHANGE_PCT_DOWN
  status              String    @default("ACTIVE") // ACTIVE, TRIGGERED, DISABLED, CANCELLED
  notificationChannel String    @default("EMAIL") // EMAIL, PUSH, ALL
  destinationEmail    String?
  triggerPrice        Float?
  lastCheckedAt       DateTime?
  triggeredAt         DateTime?
  activatedAt         DateTime? @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, status])
  @@index([ticker, status])
  @@index([status, lastCheckedAt])
}

model Holding {
  id          String @id @default(uuid())
  portfolioId String
  assetId     String

  quantity    Decimal @default(0)
  averageCost Decimal @default(0) // WAC

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@unique([portfolioId, assetId])
}

model Transaction {
  id          String  @id @default(uuid())
  portfolioId String
  assetId     String? // Null for DEPOSIT/WITHDRAW

  type String // BUY, SELL, DIVIDEND, FEE, DEPOSIT, WITHDRAW
  date DateTime @default(now())

  quantity     Decimal @default(0)
  pricePerUnit Decimal @default(0)
  fee          Decimal @default(0)
  total        Decimal @default(0)
  currency     String  @default("USD")

  notes String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset?    @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now())

  @@index([portfolioId])
  @@index([portfolioId, date])
}

model CashAccount {
  id          String  @id @default(uuid())
  portfolioId String
  currency    String
  balance     Decimal @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, currency])
}

// Personal finance workspace. These records are intentionally separate from
// investment portfolio transactions: a household expense must never alter an
// investment holding or its performance history.
model PersonalFinanceAccount {
  id            String   @id @default(uuid())
  userId        String
  name          String
  institution   String?
  kind          String   @default("bank")
  currency      String   @default("ARS")
  balance       Decimal  @default(0)
  hidden        Boolean  @default(false)
  changePct     Float    @default(0)
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      PersonalFinanceTransaction[]
  recurringPayments PersonalFinanceRecurringPayment[]
  cards             PersonalFinanceCard[]

  @@index([userId])
}

model PersonalFinanceTransaction {
  id           String   @id @default(uuid())
  userId       String
  accountId    String?
  cardId       String?
  date         DateTime @default(now())
  description  String
  merchant     String?
  category     String   @default("Otros")
  categoryKey  String   @default("other")
  type         String   @default("expense")
  amount       Decimal  @default(0)
  currency     String   @default("ARS")
  status       String   @default("confirmed")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account PersonalFinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card    PersonalFinanceCard?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryKey, date])
  @@index([accountId])
  @@index([cardId])
}

model PersonalFinanceBudget {
  id          String   @id @default(uuid())
  userId      String
  category    String
  categoryKey String
  limit       Decimal  @default(0)
  month       Int
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryKey, month, year])
  @@index([userId, year, month])
}

model PersonalFinanceGoal {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  icon               String   @default("○")
  saved              Decimal  @default(0)
  target             Decimal  @default(0)
  currency           String   @default("ARS")
  deadline           DateTime?
  monthlyContribution Decimal @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PersonalFinanceRecurringPayment {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  name        String
  category    String   @default("Suscripciones")
  amount      Decimal  @default(0)
  currency    String   @default("ARS")
  nextDate    DateTime
  frequency   String   @default("monthly")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account PersonalFinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, nextDate])
}

model PersonalFinanceCard {
  id             String   @id @default(uuid())
  userId         String
  accountId      String?
  name           String
  brand          String   @default("Visa")
  last4          String?
  currency       String   @default("ARS")
  creditLimit    Decimal  @default(0)
  currentBalance Decimal  @default(0)
  closingDay     Int?
  dueDay         Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      PersonalFinanceAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions PersonalFinanceTransaction[]

  @@index([userId])
}

model Watchlist {
  id      String @id @default(uuid())
  name    String
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  tickers String

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// NEWS SYSTEM MODELS
// ============================================

model NewsSource {
  id                 String    @id @default(uuid())
  name               String    @unique
  apiType            String    @default("rss") // 'rss', 'api', 'scraper'
  baseUrl            String?
  apiUrl             String?
  /// Legacy alias kept while existing integrations migrate to baseUrl.
  url                String?
  rssUrl             String?
  country            String    @default("GLOBAL") // 'AR', 'US', 'GLOBAL'
  language           String    @default("es")
  isActive           Boolean   @default(true)
  priority           Int       @default(0) // Higher = more important
  reliabilityScore   Int       @default(50)
  lastSuccessfulSync DateTime?
  lastError          String?

  news           News[]
  categoryLinks  NewsSourceCategory[]
  articleSources NewsArticleSource[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  NewsArticle NewsArticle[]
}

model NewsCategory {
  id              String    @id @default(uuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  color           String? // For UI display
  icon            String? // Icon identifier
  image           String? // Category hero image
  isActive        Boolean   @default(true)
  displayOrder    Int       @default(0) // Sort order in UI
  updateFrequency String    @default("WEEKLY") // DAILY | WEEKLY | MANUAL
  updateHour      Int       @default(9)
  updateMinute    Int       @default(0)
  updateDayOfWeek Int       @default(0) // Sunday = 0, used by WEEKLY
  lastUpdatedAt   DateTime?
  nextUpdateAt    DateTime?

  news        News[]
  slots       NewsSlot[]
  articles    NewsArticle[]
  sourceLinks NewsSourceCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id String @id @default(uuid())

  // Content
  title     String
  titleEs   String? // Spanish translation if original is English
  content   String // Full article content
  contentEs String? // Spanish translation
  summary   String // Short summary
  summaryEs String?

  // Metadata
  url           String  @unique
  urlHash       String  @unique // MD5 hash to prevent duplicates
  imageUrl      String?
  language      String  @default("es") // Original language
  wasTranslated Boolean @default(false)

  // Classification
  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id])

  sourceId String
  source   NewsSource @relation(fields: [sourceId], references: [id])

  author String?

  // Analysis
  sentiment      String? // 'positive', 'neutral', 'negative'
  sentimentScore Float? // -1.0 to 1.0
  impactLevel    String? // 'high', 'medium', 'low'

  // Associated companies/tickers
  tickers String @default("") // Comma-separated tickers

  // Engagement
  viewCount Int @default(0)

  // Dates
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([categoryId])
  @@index([sourceId])
  @@index([sentiment])
}

model FundamentalData {
  id     String @id @default(uuid())
  ticker String @unique

  // Valuation
  pe            Float?
  forwardPe     Float?
  ps            Float?
  pb            Float?
  evEbitda      Float?
  dividendYield Float?

  // Profitability
  roe             Float?
  roa             Float?
  netMargin       Float?
  operatingMargin Float?
  grossMargin     Float?

  // Growth
  revenueGrowth3Y Float?
  revenueGrowth5Y Float?
  epsGrowth       Float?

  // Solidity
  debtEquity   Float?
  currentRatio Float?
  quickRatio   Float?
  freeCashFlow Float?

  // Risk
  beta        Float?
  volatility  Float?
  maxDrawdown Float?

  // Finix Score
  finixScore   Float?
  scoreDetails String? // JSON string

  // AI Analysis
  aiSummary        String?
  strengths        String // JSON stringified array
  risks            String // JSON stringified array
  sectorComparison String?
  conclusion       String?

  lastUpdated DateTime @default(now())
}

model FundamentalSnapshot {
  id                String    @id @default(uuid())
  cacheKey          String    @unique
  ticker            String
  providerRequested String
  providerUsed      String
  payload           String
  fetchedAt         DateTime  @default(now())
  expiresAt         DateTime
  staleAt           DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([ticker, providerRequested])
  @@index([expiresAt])
}

model ProviderHealth {
  provider       String    @id
  state          String    @default("healthy") // healthy | degraded | open
  failCount      Int       @default(0)
  consecutive429 Int       @default(0)
  lastError      String?
  lastFailureAt  DateTime?
  cooldownUntil  DateTime?
  updatedAt      DateTime  @updatedAt
}

// ============================================
// COMMUNITIES SYSTEM MODELS
// ============================================

model Community {
  id          String  @id @default(uuid())
  slug        String? @unique
  creatorId   String
  creator     User    @relation("CommunityCreator", fields: [creatorId], references: [id])
  name        String
  description String
  category    String // Actions, Crypto, ETFs, Argentina, USA

  imageUrl    String?
  bannerUrl   String?
  accentColor String? @default("#10B981")
  tags        String  @default("")

  privacyType           String  @default("PUBLIC") // PUBLIC, PRIVATE, EXCLUSIVE
  status                String  @default("PUBLISHED") // DRAFT, PUBLISHED, SUSPENDED, ARCHIVED
  isVerified            Boolean @default(false) // Comunidad de asesoramiento aprobada por Finix
  isFeatured            Boolean @default(false)
  popularityScore       Float   @default(0)
  showContentBeforeJoin Boolean @default(true)
  rules                 String?
  maxMembers            Int? // nullable
  paymentGatewayConfig  String? // JSON string: { provider, stripeAccountId, mpPublicKey, mpAccessToken, alias, cbu, bankName, holderName, currency, isEnabled }

  members      CommunityMember[]
  posts        Post[]
  events       CommunityEvent[]
  plans        CommunityPlan[]
  payments     CommunityPayment[]
  resources    CommunityResource[]
  sections     CommunitySection[]
  joinRequests CommunityJoinRequest[]
  invites      CommunityInvite[]
  reports      CommunityReport[]
  auditLogs    CommunityAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([creatorId])
  @@index([createdAt])
  @@index([popularityScore])
  @@index([isFeatured])
}

model CommunityPlan {
  id            String    @id @default(uuid())
  communityId   String
  community     Community @relation(fields: [communityId], references: [id])
  name          String // Ej: "VIP", "Pro"
  price         Decimal
  interval      String    @default("monthly") // "monthly", "yearly" o "one_time"
  features      String // JSON array beneficios
  tierLevel     Int       @default(0) // 0 (Free), 10 (Pro), 20 (VIP)
  stripePriceId String?

  members CommunityMember[]
}

model CommunityEvent {
  id                String    @id @default(uuid())
  communityId       String
  community         Community @relation(fields: [communityId], references: [id])
  title             String
  description       String?
  eventDate         DateTime
  requiredTierLevel Int       @default(0)
  link              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityResource {
  id                String    @id @default(uuid())
  communityId       String
  community         Community @relation(fields: [communityId], references: [id])
  title             String
  description       String?
  resourceUrl       String
  isPublic          Boolean   @default(false)
  requiredTierLevel Int       @default(0)
  authorId          String?
  author            User?     @relation(fields: [authorId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  subscriptionStatus   String    @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED | PAST_DUE
  paymentStatus        String?   @default("SUCCEEDED")
  role                 String    @default("MEMBER") // OWNER | ADMIN | MODERATOR | MEMBER
  stripePaymentId      String?
  stripeSubscriptionId String?
  expiresAt            DateTime?

  planId String?
  plan   CommunityPlan? @relation(fields: [planId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([communityId, userId])
  @@index([userId, subscriptionStatus])
  @@index([communityId, role])
}

model CommunityPayment {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  creatorId String

  amount           Decimal
  commissionAmount Decimal
  creatorAmount    Decimal
  stripePaymentId  String  @unique
  status           String  @default("SUCCEEDED") // PENDING | SUCCEEDED | FAILED | REFUNDED
  payoutStatus     String  @default("PENDING")
  billingType      String  @default("monthly") // monthly | yearly

  createdAt DateTime @default(now())

  revenueEntry FinixRevenue?

  @@index([communityId, createdAt])
  @@index([userId, createdAt])
}

model CommunitySection {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String?   @default("Hash")
  order       Int       @default(0)
  visibility  String    @default("PUBLIC") // PUBLIC, MEMBERS_ONLY, PREMIUM
  isActive    Boolean   @default(true)
  posts       Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId, order])
}

model CommunityJoinRequest {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  reviewedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([communityId, userId])
  @@index([communityId, status])
}

model CommunityInvite {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  code        String    @unique
  createdById String
  createdBy   User      @relation("CommunityInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([communityId])
}

model CommunityReport {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   String // POST, COMMENT, USER
  targetId     String
  reason       String // SPAM, FRAUD, INAPPROPRIATE, FAKE_INFO, HARASSMENT, ADVERTISING, OTHER
  details      String?
  status       String    @default("PENDING") // PENDING, RESOLVED, DISMISSED
  actionTaken  String? // NONE, DELETED, HIDDEN, WARNED, MUTED, BANNED
  reviewedById String?
  reviewedBy   User?     @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([communityId, status])
}

model CommunityAuditLog {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation("CommunityAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action      String // COMMUNITY_CREATED, COMMUNITY_UPDATED, MEMBER_BANNED, MEMBER_REMOVED, ROLE_CHANGED, PRICE_CHANGED, PLAN_CREATED, PLAN_UPDATED, POST_DELETED, POST_PINNED, SETTINGS_UPDATED, PAYOUT_UPDATED
  targetId    String?
  metadata    String? // JSON payload
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
}

model Subscription {
  id                           String    @id @default(uuid())
  userId                       String
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId         String?   @unique
  stripeCustomerId             String?
  mercadoPagoPreapprovalId     String?   @unique
  mercadoPagoExternalReference String?
  mercadoPagoPaymentId         String?   @unique
  status                       String    @default("INACTIVE") // INACTIVE | ACTIVE | CANCELED | PAST_DUE | EXPIRED
  planType                     String    @default("PRO") // PRO | CREATOR (Stripe legacy values are also supported)
  startDate                    DateTime  @default(now())
  endDate                      DateTime?
  cancelAtPeriodEnd            Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  revenues FinixRevenue[]

  @@index([userId, status])
}

model FinixRevenue {
  id             String            @id @default(uuid())
  type           String // PLAN | COMMUNITY
  paymentId      String?           @unique
  payment        CommunityPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  communityId String?
  userId      String?
  creatorId   String?
  status      String  @default("COMPLETED")

  totalAmount      Decimal
  commissionAmount Decimal
  creatorAmount    Decimal
  createdAt        DateTime @default(now())

  @@index([type, createdAt])
}

model CreatorBalance {
  id               String   @id @default(uuid())
  creatorId        String   @unique
  creator          User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0)
  pendingBalance   Decimal  @default(0)
  updatedAt        DateTime @updatedAt

  payouts Payout[]
}

model Payout {
  id               String         @id @default(uuid())
  creatorBalanceId String
  creatorBalance   CreatorBalance @relation(fields: [creatorBalanceId], references: [id], onDelete: Cascade)
  amount           Decimal
  status           String         @default("PENDING") // PENDING | PROCESSING | PAID | FAILED | CANCELED
  stripePayoutId   String?
  createdAt        DateTime       @default(now())
  processedAt      DateTime?

  @@index([status, createdAt])
}

// ============================================
// MESSAGING SYSTEM MODELS
// ============================================

model Conversation {
  id             String                    @id @default(uuid())
  participant1Id String?
  participant2Id String?
  participant1   User?                     @relation("ConvParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User?                     @relation("ConvParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  isGroup        Boolean                   @default(false)
  title          String?
  description    String?
  createdById    String?
  createdBy      User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants   ConversationParticipant[]
  messages       DirectMessage[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([createdById])
  @@index([isGroup, updatedAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
  @@index([conversationId, lastReadAt])
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachmentType String?
  attachmentUrl  String?
  attachmentData String?
  sharedPostId   String?
  sharedPost     Post?        @relation("SharedPostMessages", fields: [sharedPostId], references: [id], onDelete: SetNull)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([sharedPostId])
}

model Story {
  id         String      @id @default(uuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String?
  mediaUrl   String?
  background String?
  textColor  String?
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  views      StoryView[]
  likes      StoryLike[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  storyId  String
  viewerId String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

model StoryLike {
  storyId   String
  userId    String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([storyId, userId])
  @@index([userId, createdAt])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentLog {
  id            String   @id @default(uuid())
  stripeEventId String?  @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          String
  status        String
  message       String?
  payload       String?
  createdAt     DateTime @default(now())

  @@index([type, createdAt])
}

// ============================================
// ADMIN REPORTING & LOGGING MODELS
// ============================================

model AdminSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model Report {
  id             String  @id @default(uuid())
  reporterId     String
  targetType     String // "POST", "USER", "COMMENT"
  targetId       String
  reason         String
  status         String  @default("OPEN") // OPEN, IN_REVIEW, RESOLVED
  resolutionNote String?

  reporter  User     @relation("Reporter", fields: [reporterId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AdminAuditLog {
  id        String  @id @default(uuid())
  action    String // e.g. "BAN_USER", "HIDE_POST", "ROLE_CHANGE"
  actorId   String
  targetId  String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  String? // JSON string

  actor     User     @relation("AdminActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model ProEmailCampaign {
  sourceKey      String?                  @unique
  audienceCursor String?
  audienceReady  Boolean                  @default(false)
  id             String                   @id @default(uuid())
  subject        String
  title          String
  message        String
  imageUrl       String?
  ctaLabel       String?
  ctaUrl         String?
  recipientCount Int                      @default(0)
  sentCount      Int                      @default(0)
  failedCount    Int                      @default(0)
  createdById    String
  createdBy      User                     @relation("ProEmailCampaignCreator", fields: [createdById], references: [id])
  createdAt      DateTime                 @default(now())
  status         String                   @default("SENT") // DRAFT | SCHEDULED | SENDING | SENT | FAILED | CANCELLED
  previewText    String?
  contentHtml    String?
  contentText    String?
  audience       String                   @default("PRO")
  scheduledAt    DateTime?
  sentAt         DateTime?
  templateId     String?
  template       EmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients     EmailCampaignRecipient[]
  events         EmailEvent[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@index([createdById, createdAt])
}

model EmailTemplate {
  id          String             @id @default(uuid())
  name        String
  type        String             @default("MARKETING")
  subject     String
  previewText String?
  contentHtml String
  contentText String?
  variables   String?
  isSystem    Boolean            @default(false)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  campaigns   ProEmailCampaign[]

  @@index([type, updatedAt])
}

model EmailCampaignRecipient {
  attempts       Int              @default(0)
  firstAttemptAt DateTime?
  nextAttemptAt  DateTime         @default(now())
  lockedUntil    DateTime?
  id             String           @id @default(uuid())
  campaignId     String
  userId         String
  email          String
  status         String           @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | BOUNCED
  providerId     String?
  error          String?
  queuedAt       DateTime         @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  updatedAt      DateTime         @updatedAt
  campaign       ProEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         EmailEvent[]

  @@unique([campaignId, userId])
  @@index([status, nextAttemptAt])
  @@index([campaignId, status])
  @@index([userId, updatedAt])
}

model EmailEvent {
  id          String                  @id @default(uuid())
  type        String // SENT | DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED | UNSUBSCRIBED
  providerId  String?
  campaignId  String?
  recipientId String?
  userId      String?
  linkUrl     String?
  metadata    String?
  createdAt   DateTime                @default(now())
  campaign    ProEmailCampaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient   EmailCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, providerId, recipientId, linkUrl])
  @@index([campaignId, type, createdAt])
  @@index([userId, createdAt])
}

model EmailPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  marketing Boolean  @default(true)
  alerts    Boolean  @default(true)
  analysis  Boolean  @default(true)
  calendar  Boolean  @default(true)
  earnings  Boolean  @default(true)
  daily     Boolean  @default(true)
  weekly    Boolean  @default(true)
  community Boolean  @default(true)
  product   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSegment {
  id          String   @id @default(uuid())
  name        String
  definition  String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("EmailSegmentCreator", fields: [createdById], references: [id])

  @@index([createdById, updatedAt])
}

model EmailMedia {
  id           String   @id @default(uuid())
  url          String
  altText      String?
  mimeType     String?
  size         Int?
  uploadedById String
  createdAt    DateTime @default(now())
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([createdAt])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type     String
  priority String @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL

  title   String
  message String?
  link    String?

  isRead Boolean   @default(false)
  readAt DateTime?

  entityType String?
  entityId   String?

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  metadata String? // JSON payload (e.g. grouped users, market data)

  createdAt DateTime @default(now())

  // Indexes specific for querying
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt]) // useful for unread count + fetch
  @@index([type])
}

// ============================================
// HUB (COMUNIDAD FINIX) MODELS
// ============================================

model HubChannel {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  icon        String? // emoji
  type        String   @default("CHAT") // CHAT | FEED
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  messages HubMessage[]
  posts    HubPost[]

  @@index([order])
}

model HubMessage {
  id        String     @id @default(uuid())
  channelId String
  channel   HubChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("HubMessages", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mediaUrl  String?
  isPinned  Boolean    @default(false)
  createdAt DateTime   @default(now())
  editedAt  DateTime?

  @@index([channelId, createdAt])
  @@index([authorId])
}

model HubPost {
  id        String     @id @default(uuid())
  channelId String
  channel   HubChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("HubPosts", fields: [authorId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  mediaUrl  String?
  isPinned  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  comments HubComment[]

  @@index([channelId, isPinned, createdAt])
  @@index([authorId])
}

model HubComment {
  id        String   @id @default(uuid())
  postId    String
  post      HubPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("HubComments", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

model HubEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  link        String?
  authorId    String
  author      User      @relation("HubEvents", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([startsAt])
}

model HubResource {
  id           String   @id @default(uuid())
  title        String
  description  String?
  url          String
  mediaType    String   @default("link") // video | audio | pdf | image | article | link | file
  thumbnailUrl String?
  duration     String? // e.g. "1:23:45"
  category     String?
  authorId     String
  author       User     @relation("HubResources", fields: [authorId], references: [id], onDelete: Cascade)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([category, order])
  @@index([mediaType])
}

model FinancialAdvisorVerification {
  id                        String    @id @default(uuid())
  userId                    String
  user                      User      @relation("UserFinancialVerifications", fields: [userId], references: [id], onDelete: Cascade)
  status                    String    @default("pending") // pending, under_review, approved, rejected, suspended, expired
  fullName                  String
  documentType              String
  documentCountry           String
  documentNumber            String
  professionalCategory      String
  registrationNumber        String
  registrationEntity        String
  professionalCountry       String
  identityDocumentFrontPath String
  identityDocumentBackPath  String
  professionalDocumentPath  String
  experienceYears           Int?
  specialization            String?
  company                   String?
  professionalPosition      String?
  cvPath                    String?
  website                   String?
  linkedin                  String?
  professionalDescription   String?
  submittedAt               DateTime  @default(now())
  reviewedAt                DateTime?
  reviewedById              String?
  reviewedBy                User?     @relation("FinancialVerificationsReviewed", fields: [reviewedById], references: [id])
  rejectionReason           String?
  adminNotes                String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  auditLogs FinancialVerificationAuditLog[]

  @@index([userId])
  @@index([status])
}

model FinancialVerificationAuditLog {
  id             String                       @id @default(uuid())
  verificationId String
  verification   FinancialAdvisorVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  adminId        String?
  admin          User?                        @relation("FinancialVerificationAuditLogs", fields: [adminId], references: [id])
  action         String
  previousStatus String?
  newStatus      String?
  reason         String?
  createdAt      DateTime                     @default(now())

  @@index([verificationId])
  @@index([adminId])
}

model PushSubscription {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String   @unique
  p256dh        String
  auth          String
  cursorAt      DateTime @default(now())
  cursorId      String   @default("")
  failures      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lease         String?

  @@index([nextAttemptAt, failures])
  @@index([userId])
}

model AssetAnalysis {
  emailAnnounced Boolean  @default(false)
  id             String   @id @default(uuid())
  symbol         String // e.g. "NASDAQ:AAPL" or "AAPL"
  isActive       Boolean  @default(true) // Si está activo, será el que se muestre como destacado
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 1. Información de la empresa
  companyName          String?
  ticker               String?
  sector               String?
  industry             String?
  country              String?
  foundedYear          Int?
  ceo                  String?
  employeesCount       Int?
  marketCap            Float?
  businessDescription  String?
  productsServices     String?
  revenueGeneration    String?
  mainRevenueSources   String?
  geographicRevenue    String?
  businessSegments     String?
  mainCompetitors      String?
  competitiveAdvantage String?
  customerDependency   String?
  productDependency    String?
  marketShare          String?

  // 2. Ingresos y crecimiento
  revenue                Float?
  revenueGrowthYoY       Float?
  revenueCagr3y          Float?
  revenueCagr5y          Float?
  growthBySegment        String?
  growthByRegion         String?
  recurringRevenue       String?
  arr                    Float?
  mrr                    Float?
  revenueGuidance        String?
  estimatedRevenue       Float?
  realVsEstimatedRevenue String?

  // 3. Rentabilidad
  eps                Float?
  epsGrowth          Float?
  epsEstimatedVsReal String?
  grossMargin        Float?
  operatingMargin    Float?
  netMargin          Float?
  ebit               Float?
  ebitda             Float?
  ebitdaMargin       Float?
  roe                Float?
  roa                Float?
  roic               Float?
  roce               Float?
  freeCashFlow       Float?
  fcfMargin          Float?
  fcfGrowth          Float?

  // 4. Valuación
  peRatio                  Float?
  forwardPe                Float?
  pegRatio                 Float?
  priceToSales             Float?
  priceToBook              Float?
  evToEbitda               Float?
  evToRevenue              Float?
  priceToFcf               Float?
  dividendYield            Float?
  marketCapToFcf           Float?
  historicalValuation      String?
  historicalAvgPe          Float?
  sectorPe                 Float?
  competitorsPe            String?
  estimatedFairValue       Float?
  valuationPremiumDiscount Float?

  // 5. Balance financiero
  cash                  Float?
  totalDebt             Float?
  netDebt               Float?
  netDebtToEbitda       Float?
  currentRatio          Float?
  quickRatio            Float?
  totalAssets           Float?
  totalLiabilities      Float?
  equity                Float?
  equityGrowth          Float?
  longTermDebt          Float?
  shortTermDebt         Float?
  interestPaid          Float?
  interestCoverageRatio Float?

  // 6. Cash Flow
  operatingCashFlow        Float?
  capEx                    Float?
  // freeCashFlow is in section 3 but can be shared
  fcfPerShare              Float?
  fcfYield                 Float?
  earningsToCashConversion Float?
  historicalCashFlow       String?
  // fcfGrowth is in section 3

  // 7. Accionistas y mercado
  sharesOutstanding      Float?
  shareDilution          Float?
  insiderOwnership       Float?
  institutionalOwnership Float?
  insiderBuys            String?
  insiderSells           String?
  buybacks               String?
  sharesGrowthReduction  String?
  shortInterest          Float?
  shortFloat             Float?
  beta                   Float?

  // 8. Análisis técnico
  currentPrice         Float?
  dailyChange          Float?
  weeklyChange         Float?
  monthlyChange        Float?
  yearlyChange         Float?
  high52w              Float?
  low52w               Float?
  distanceToHigh       Float?
  distanceToLow        Float?
  volume               Float?
  avgVolume            Float?
  relativeVolume       Float?
  sma20                Float?
  sma50                Float?
  sma100               Float?
  sma200               Float?
  rsi                  Float?
  macd                 String?
  bollingerBands       String?
  atr                  Float?
  supports             String?
  resistances          String?
  trend                String?
  momentum             String?
  historicalVolatility Float?

  // Identificadores y publicación
  slug            String?   @unique
  status          String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  exchange        String?
  logoUrl         String?
  analysisDate    DateTime?
  sources         String?
  legalDisclaimer String?

  // Secciones estructuradas (JSON almacenado como String)
  sectionVisibility    String? // JSON: { showCompany: true, showGrowth: true, ... }
  executiveSummary     String? // JSON: { title, summary, positivePoints: [], negativePoints: [], conclusion }
  businessModel        String? // JSON: [{ product, description, revenuePct, growth, margin }]
  historicalSeries     String? // JSON: { revenue: [], eps: [], margins: [], cashFlow: [], debt: [], pe: [], shares: [] }
  segmentGrowth        String? // JSON: [{ segment, revenue, growth, pctOfTotal }]
  competitorsData      String? // JSON: [{ name, ticker, revenue, growth, pe, roic, netMargin, fcf, marketCap, debt }]
  technicalData        String? // JSON: { priceSeries: [], movingAverages: [], rsiSeries: [], macd: {}, supports: [], resistances: [], technicalScore: 74, technicalSignal: 'BUY' }
  risksData            String? // JSON: [{ title, description, severity, probability, impact }]
  catalystsData        String? // JSON: [{ title, description, horizon, impact }]
  scenariosData        String? // JSON: { bull: {...}, base: {...}, bear: {...} }
  valuationMethodology String? // JSON: { method, assumptions, result, date, notes }
  swotData             String? // JSON: { strengths: [], weaknesses: [], opportunities: [], threats: [] }

  auditLogs AnalysisAuditLog[]

  @@index([status])
  @@index([ticker])
}

model AnalysisAuditLog {
  id         String        @id @default(uuid())
  analysisId String
  analysis   AssetAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  userId     String?
  action     String // CREATE, UPDATE, STATUS_CHANGE, DELETE
  field      String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime      @default(now())

  @@index([analysisId])
  @@index([createdAt])
}

// ============================================
// NEWS CMS SLOT SYSTEM
// ============================================

// NewsArticle: un artículo asignado manualmente por el admin a un slot
model NewsArticle {
  id               String  @id @default(uuid())
  url              String  @unique
  canonicalUrl     String? @unique
  normalizedTitle  String?
  eventFingerprint String?
  relevanceScore   Int     @default(0)

  // Metadata automática (extraída por scraping)
  title       String
  description String?
  imageUrl    String?
  sourceName  String?
  sourceUrl   String?
  publishedAt DateTime?
  author      String?

  // Flags de override manual (cuando el admin edita manualmente)
  customTitle       Boolean @default(false)
  customDescription Boolean @default(false)
  customImage       Boolean @default(false)

  // Estado del artículo
  isActive    Boolean @default(true)
  isPublished Boolean @default(false)
  status      String  @default("DRAFT") // DRAFT | PUBLISHED | INACTIVE | ERROR

  // Categoría opcional (para contexto)
  categoryId String?
  category   NewsCategory? @relation(fields: [categoryId], references: [id])
  sourceId   String?
  source     NewsSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots             NewsSlot[]
  additionalSources NewsArticleSource[]
  historyAsPrev     NewsSlotHistory[]   @relation("PreviousArticle")
  historyAsNew      NewsSlotHistory[]   @relation("NewArticle")

  @@index([categoryId])
  @@index([status])
  @@index([isPublished])
  @@index([relevanceScore, publishedAt])
  @@index([eventFingerprint])
  @@index([sourceId])
}

model NewsSourceCategory {
  sourceId         String
  categoryId       String
  priority         Int          @default(0)
  reliabilityScore Int          @default(50)
  isActive         Boolean      @default(true)
  source           NewsSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  category         NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@id([sourceId, categoryId])
  @@index([categoryId])
}

model NewsArticleSource {
  id         String   @id @default(uuid())
  articleId  String
  sourceId   String?
  sourceName String
  url        String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source  NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([articleId, url])
  @@index([articleId])
  @@index([sourceId])
}

model NewsSyncLog {
  id                  String    @id @default(uuid())
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  frequency           String
  categoriesProcessed String    @default("[]")
  sourcesProcessed    String    @default("[]")
  articlesFound       Int       @default(0)
  articlesCreated     Int       @default(0)
  articlesUpdated     Int       @default(0)
  duplicatesDetected  Int       @default(0)
  failedSources       String    @default("[]")
  status              String    @default("RUNNING")
  errorMessage        String?

  @@index([startedAt])
  @@index([frequency, status])
}

// NewsSlot: posición fija en el mosaico de una categoría
model NewsSlot {
  id         String       @id @default(uuid())
  categoryId String
  category   NewsCategory @relation(fields: [categoryId], references: [id])

  slotKey  String @unique // ej: "economia_slot_1"
  position Int // 1-5

  articleId String?
  article   NewsArticle? @relation(fields: [articleId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history NewsSlotHistory[]

  @@unique([categoryId, position])
  @@index([categoryId])
  @@index([articleId])
}

// NewsSlotHistory: auditoría de cambios de contenido en slots
model NewsSlotHistory {
  id     String   @id @default(uuid())
  slotId String
  slot   NewsSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  previousArticleId String?
  previousArticle   NewsArticle? @relation("PreviousArticle", fields: [previousArticleId], references: [id])

  newArticleId String?
  newArticle   NewsArticle? @relation("NewArticle", fields: [newArticleId], references: [id])

  changedBy String? // admin user id
  changedAt DateTime @default(now())

  @@index([slotId])
  @@index([changedAt])
}

// ─── Market Rankings (S&P 500 & Top Gainers) ───────────────────────────

model SP500Asset {
  id          String   @id @default(uuid())
  ticker      String   @unique
  companyName String
  exchange    String   @default("US")
  sector      String?
  industry    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rankings DailyMarketRanking[]

  @@index([ticker])
  @@index([isActive])
}

model DailyMarketRanking {
  id           String      @id @default(uuid())
  date         String // Format: YYYY-MM-DD
  rankingType  String // TOP_GAINERS, TOP_LOSERS, etc.
  rank         Int // 1 to 5 (or up to N)
  sp500AssetId String?
  sp500Asset   SP500Asset? @relation(fields: [sp500AssetId], references: [id], onDelete: SetNull)

  ticker          String
  companyName     String
  price           Float
  previousClose   Float
  change          Float
  changePercent   Float
  volume          Float
  logoUrl         String?
  marketTimestamp DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, rankingType, rank])
  @@index([date, rankingType])
  @@index([ticker])
}

model MarketRankingExecutionLog {
  id              String   @id @default(uuid())
  executedAt      DateTime @default(now())
  rankingType     String
  targetDate      String
  status          String // SUCCESS, PARTIAL, FAILED
  providerUsed    String
  assetsProcessed Int
  errorsCount     Int
  durationMs      Int
  topResultsJson  String? // JSON preview of TOP 5
  errorMessage    String?

  @@index([executedAt])
  @@index([targetDate])
}

model MarketCalendarEvent {
  id                   String   @id @default(uuid())
  externalId           String?
  sourceId             String?
  sourceName           String? // Official source name: BLS, INDEC, Federal Reserve, etc.
  eventType            String   @default("ECONOMIC") // ECONOMIC, CORPORATE_EVENT, EARNINGS, MARKET
  country              String // US, AR, EU, UK, JP, etc.
  countryCode          String? // US, AR, etc.
  currency             String? // USD, ARS
  assetId              String?
  title                String
  description          String?
  category             String // INFLATION, CENTRAL_BANK, EMPLOYMENT, GDP, etc.
  subcategory          String?
  importance           String   @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW (compat)
  impact               String   @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  marketImpactScore    Int      @default(0) // 0 to 100 (compat)
  impactScore          Int      @default(0) // 0 to 100
  date                 String // YYYY-MM-DD
  time                 String? // 10:30, 16:00
  timestampUtc         DateTime
  timezone             String   @default("UTC")
  previousValue        String?
  forecastValue        String?
  consensusValue       String?
  actualValue          String?
  unit                 String?
  surprise             Float?
  surprisePercent      Float?
  expectedMarketEffect String?
  affectedAssets       String? // JSON string or comma-separated list of symbols: ["SPY","QQQ","BTC"]
  source               String? // Source name (compat)
  sourceUrl            String?
  sourceType           String   @default("AUTOMATIC") // AUTOMATIC, MANUAL
  companyName          String?
  ticker               String?
  status               String   @default("PUBLISHED") // DRAFT, PENDING_REVIEW, APPROVED, PUBLISHED, HIDDEN, CANCELLED
  isManual             Boolean  @default(false)
  isAutomatic          Boolean  @default(true)
  isVerified           Boolean  @default(false)
  isPublished          Boolean  @default(true)
  isFeatured           Boolean  @default(false)
  eventFingerprint     String? // country + date + canonical_slug + ticker
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([date])
  @@index([country])
  @@index([importance])
  @@index([impactScore])
  @@index([isPublished])
  @@index([status])
  @@index([category])
  @@index([ticker])
  @@index([eventFingerprint])
  @@index([sourceId])
}

model CalendarSource {
  id           String    @id @default(uuid())
  name         String
  type         String // OFFICIAL, FINANCIAL_API, TRADINGVIEW, SCRAPER, RSS, MANUAL
  country      String // US, AR, GLOBAL
  baseUrl      String?
  apiUrl       String?
  isActive     Boolean   @default(true)
  priority     Int       @default(3) // 1 = Official, 2 = Financial API, 3 = TradingView, 4 = Investing, 5 = Other
  lastSyncAt   DateTime?
  syncStatus   String    @default("IDLE") // IDLE, SYNCING, SUCCESS, ERROR
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([country])
  @@index([isActive])
  @@index([priority])
}

model MarketEarningsEvent {
  id                  String   @id @default(uuid())
  assetId             String?
  ticker              String
  companyName         String
  logoUrl             String?
  date                String // YYYY-MM-DD
  time                String? // 18:00
  timestampUtc        DateTime
  timezone            String   @default("America/New_York")
  dateStatus          String   @default("CONFIRMED") // CONFIRMED, ESTIMATED
  reportTiming        String? // BMO (Before Market Open), AMC (After Market Close), DMH (During Market Hours)
  epsEstimate         Float?
  revenueEstimate     Float?
  actualEps           Float?
  actualRevenue       Float?
  epsSurprise         Float?
  revenueSurprise     Float?
  marketReaction      Float? // Variación % de precio post-balance
  marketCap           Float?
  earningsImpactScore Int      @default(0) // 0 to 100
  source              String?
  sourceUrl           String?
  sourceType          String   @default("AUTOMATIC") // AUTOMATIC, MANUAL
  isPublished         Boolean  @default(true)
  isFeatured          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
  @@index([ticker])
  @@index([earningsImpactScore])
  @@index([isPublished])
  @@index([dateStatus])
}

model MarketDividendEvent {
  id              String   @id @default(uuid())
  assetId         String?
  ticker          String
  companyName     String
  logoUrl         String?
  exDate          String // YYYY-MM-DD
  paymentDate     String? // YYYY-MM-DD
  recordDate      String? // YYYY-MM-DD
  declarationDate String? // YYYY-MM-DD
  amount          Float? // Monto del dividendo por acción en USD
  yield           Float? // Rendimiento de dividendo (%)
  frequency       String? // Ej: Trimestral, Anual
  marketCap       Float?
  source          String?  @default("TradingView Official Scanner")
  sourceType      String   @default("AUTOMATIC")
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([exDate])
  @@index([paymentDate])
  @@index([ticker])
  @@index([isPublished])
}

model CalendarSyncLog {
  id              String    @id @default(uuid())
  executedAt      DateTime  @default(now())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  sourceId        String?
  syncType        String // ALL, MACRO, ECONOMIC, EARNINGS, SOURCE
  status          String // SUCCESS, PARTIAL, FAILED
  providerUsed    String
  eventsProcessed Int       @default(0)
  eventsFound     Int       @default(0)
  eventsCreated   Int       @default(0)
  eventsUpdated   Int       @default(0)
  duplicates      Int       @default(0)
  errorsCount     Int       @default(0)
  durationMs      Int       @default(0)
  errorMessage    String?

  @@index([executedAt])
  @@index([syncType])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Technical Chart Analysis & Versioning System
// ─────────────────────────────────────────────────────────────────────────────

model ChartAnalysis {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserChartAnalyses", fields: [userId], references: [id], onDelete: Cascade)

  title       String  @default("Análisis Técnico")
  description String?
  symbol      String // e.g. "NASDAQ:AAPL", "BYMA:GGAL", "BINANCE:BTCUSDT"
  exchange    String? // e.g. "NASDAQ", "BYMA", "BINANCE", "NYSE"
  timeframe   String  @default("1D") // "1", "5", "15", "60", "1D", "1W", "1M"

  // Structural chart state (drawings, coordinates, points, styles, visible range, indicators)
  chartState Json

  isPublic     Boolean         @default(false)
  forkedFromId String?
  forkedFrom   ChartAnalysis?  @relation("ChartAnalysisForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        ChartAnalysis[] @relation("ChartAnalysisForks")

  versions ChartAnalysisVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([createdAt])
}

model ChartAnalysisVersion {
  id         String        @id @default(uuid())
  analysisId String
  analysis   ChartAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  versionNumber Int  @default(1)
  chartState    Json // Immutable frozen snapshot

  posts Post[]

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([createdAt])
}
