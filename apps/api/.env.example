# ─────────────────────────────────────────────────────────────────────────────
# FINIX API — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010

# Public URLs
API_URL=https://finixarg.com
FRONTEND_URL=https://finixarg.com
APP_URL=https://finixarg.com
ALLOWED_ORIGINS=https://finixarg.com,https://www.finixarg.com
ADMIN_URL=https://admin.finixarg.com

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Pooled connection (for runtime queries via PgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Direct connection (for Prisma migrations only)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Authentication ────────────────────────────────────────────────────────────
# Own JWT secret (generate with: openssl rand -base64 64)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# JWKS-based validation (RS256/ES256) — preferred. Leave empty to use legacy HS256.
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# Legacy HS256 secret (Dashboard → Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET
# Service role key (Dashboard → Settings → API → Legacy API Keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_OWNER_EMAIL=admin@yourdomain.com
ADMIN_ALLOWLIST=admin@yourdomain.com
ADMIN_IP_ALLOWLIST=127.0.0.1/32,::1/128

# ── Email (Resend) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=Finix <noreply@yourdomain.com>

# ── Market Data APIs ──────────────────────────────────────────────────────────
# Financial Modeling Prep
FMP_API_KEY=REPLACE_WITH_FMP_KEY

# Finnhub
FINNHUB_API_KEY=REPLACE_WITH_FINNHUB_KEY

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=REPLACE_WITH_ALPHA_VANTAGE_KEY

# ── AI (Ollama — local LLM) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT_MS=45000

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use test keys in staging, live keys ONLY in production
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET
STRIPE_PRO_INVESTOR_PRICE_ID=price_REPLACE
STRIPE_PRO_CREATOR_PRICE_ID=price_REPLACE

# ── Monitoring (optional but recommended) ─────────────────────────────────────
# Sentry DSN — https://sentry.io
# SENTRY_DSN=https://...@sentry.io/...

# PostHog analytics
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com

# ── Redis (for rate limiting, caching, BullMQ) ───────────────────────────────
# REDIS_URL=redis://:PASSWORD@HOST:6379

# ── Storage (R2 / S3 for media uploads) ──────────────────────────────────────
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=REPLACE
# S3_SECRET_KEY=REPLACE
# S3_BUCKET=finix-uploads
# S3_PUBLIC_URL=https://cdn.finixarg.com
