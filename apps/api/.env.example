# ─────────────────────────────────────────────────────────────────────────────
# FINIX API — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
API_BIND_HOST=127.0.0.1

# Public URLs
API_URL=https://finixarg.com
FRONTEND_URL=https://finixarg.com
APP_URL=https://finixarg.com
ALLOWED_ORIGINS=https://finixarg.com,https://www.finixarg.com,https://admin.finixarg.com
ADMIN_URL=https://admin.finixarg.com
# Opcional si se desea compartir cookies entre subdominios:
# ADMIN_COOKIE_DOMAIN=.finixarg.com

# ── Native PostgreSQL, separate runtime and migration roles ──────────────────
DATABASE_URL=postgresql://finix_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:15432/finix_prod?schema=public&connection_limit=10&pool_timeout=15&connect_timeout=10

# Direct connection (for Prisma migrations only)
DIRECT_URL=postgresql://finix_owner:REPLACE_WITH_OWNER_PASSWORD@127.0.0.1:15432/finix_prod?schema=public&connection_limit=3
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:16379
FINIX_CACHE_PREFIX=finix:v1
# Persistent files outside immutable releases; private files are never static.
UPLOADS_DIR=/opt/finix/shared/uploads
FINIX_PRIVATE_STORAGE_DIR=/opt/finix/shared/private/storage
# Emits diagnostic response headers and all request timing logs when true.
FINIX_REQUEST_METRICS=false

# ── Authentication ────────────────────────────────────────────────────────────
# Own JWT secret (generate with: openssl rand -base64 64)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
# Persistent browser sessions: one session per browser/device, revoked only on
# explicit logout. Leave empty (or use 0/never) for no automatic expiration.
AUTH_REFRESH_TTL_SECONDS=0

# Google OAuth directly through Finix (no Supabase).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://finixarg.com/api/auth/google/callback

# Local testing only: local PostgreSQL, Mailpit, no scheduled jobs.
# Never enable in production.
FINIX_LOCAL_MODE=false

# ── Admin (Acceso y Seguridad 2FA) ─────────────────────────────────────────────
ADMIN_OWNER_EMAIL=admin@finixarg.com
ADMIN_ALLOWLIST=admin@finixarg.com
# Preserve the existing value. If it was absent, use the previous JWT_SECRET.
# Generating a new value would prevent decrypting existing administrator TOTP.
ADMIN_TOTP_ENCRYPTION_KEY=REPLACE_WITH_PRESERVED_ENCRYPTION_KEY
# Persistent admin browser sessions; revoked explicitly by logout.
ADMIN_REFRESH_TTL_SECONDS=31536000

# Optional one-time bootstrap for the official Finix account.
# Never commit the real password; pass it only when running ensure:official.
FINIX_OFFICIAL_EMAIL=finiixarg@gmail.com
FINIX_OFFICIAL_USERNAME=finixarg
# FINIX_OFFICIAL_PASSWORD=use-a-secret-only-at-runtime
# ADMIN_IP_ALLOWLIST=
# Dejar vacío permite el acceso desde cualquier IP y mantiene la protección de
# credenciales + 2FA. Si se completa, debe incluir la IP pública del equipo
# administrador (por ejemplo: 200.10.20.30/32); 127.0.0.1 solo permite al VPS.

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Temporary free launch: all platform features, with new purchases paused.
# Set false and reload the API to restore existing paid-plan behavior.
FINIX_FREE_ACCESS_ENABLED=true

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_RESEND_API_KEY
RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=Finix <onboarding@finixarg.com>
CONTACT_EMAIL_TO=admin@finixarg.com

# Campaigns only. Transactional authentication emails are not disabled by this flag.
EMAIL_SEND_ENABLED=false
# Generate once with: npx web-push generate-vapid-keys
# Keep the private key only on the server. Public key is returned to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Pasarela de Pagos: Mercado Pago (Argentina - ARS) ──────────────────────────
MP_ACCESS_TOKEN=APP_USR-REPLACE_WITH_MERCADOPAGO_ACCESS_TOKEN
MP_PUBLIC_KEY=APP_USR-REPLACE_WITH_MERCADOPAGO_PUBLIC_KEY
MP_ENVIRONMENT=production
# Secret generated in Mercado Pago Developers > Webhooks. Required in production.
MP_WEBHOOK_SECRET=REPLACE_WITH_MERCADOPAGO_WEBHOOK_SECRET
MP_PRO_PRICE_ARS=6300
MP_CREATOR_PRICE_ARS=29900

# ── Pasarela de Pagos: Stripe (Internacional - USD) ───────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET
STRIPE_PRO_INVESTOR_PRICE_ID=price_REPLACE
STRIPE_PRO_CREATOR_PRICE_ID=price_REPLACE

# ── Monitoring (optional but recommended) ─────────────────────────────────────
# Sentry DSN — https://sentry.io
# SENTRY_DSN=https://...@sentry.io/...

# PostHog analytics
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com

# ── Redis (for rate limiting, caching, BullMQ) ───────────────────────────────
# REDIS_URL=redis://:PASSWORD@HOST:6379

# ── Storage (R2 / S3 for media uploads) ──────────────────────────────────────
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=REPLACE
# S3_SECRET_KEY=REPLACE
# S3_BUCKET=finix-uploads
# S3_PUBLIC_URL=https://cdn.finixarg.com
