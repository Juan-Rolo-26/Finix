{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
        "paths": {}
    },
    "exclude": [
        "node_modules",
        "prisma",
        "dist",
        "test",
        "**/*.spec.ts"
    ],
    "include": ["src/**/*.ts"]
}
