# ─────────────────────────────────────────────────────────────────────────────
# FINIX WEB — Environment Variables Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL (use /api in production behind nginx, full URL in staging)
VITE_API_URL=/api

# Supabase (public/anon — safe to expose to browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_ANON_KEY

# App URL (optional, used for absolute links)
# VITE_APP_URL=https://finixarg.com

# Feature flags (optional)
# VITE_ENABLE_AI=true
# VITE_ENABLE_STRIPE=true

# Monitoring (optional)
# VITE_SENTRY_DSN=https://...@sentry.io/...
# VITE_POSTHOG_KEY=phc_...
